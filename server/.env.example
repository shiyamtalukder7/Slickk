PORT=3000
# Stable Slickk LLM provider contract. Ollama is the initial private runtime,
# not the product identity. Legacy OLLAMA_URL and OLLAMA_MODEL remain supported.
SLICKK_MODEL_PROVIDER=ollama
SLICKK_MODEL_URL=http://127.0.0.1:11434
SLICKK_MODEL_NAME=slickk-tutor-3b-backup
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=slickk-tutor-3b-backup
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=120000
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=320
MAX_HISTORY_MESSAGES=10
SLICKK_DATABASE_PATH=./data/slickk.db

# Leave empty during local development.
# For deployment, provide comma-separated allowed web origins.
CORS_ORIGINS=

# Leave empty for the private local laptop server. Production must provide
# role-bound credentials and use HTTPS.
SLICKK_API_KEYS_JSON=
RATE_LIMIT_PER_MINUTE=120
# Enable only when exactly one trusted reverse proxy sits in front of SLICKK.
TRUST_PROXY=false
